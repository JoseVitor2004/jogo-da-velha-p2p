<?xml version="1.0" encoding="UTF-8"?>
<project name="pitiupi.jogoDaVelha" default="jar" basedir=".">
    <!-- Rodando na raiz do clone: plugins/jogodavelha -> pitiupi/dist/pitiupi.jar -->
    <property name="core.jar" location="../../pitiupi/dist/pitiupi.jar"/>
    <property name="src.dir" location="src"/>
    <property name="build.dir" location="build"/>
    <property name="dist.dir" location="dist"/>

    <target name="check-core">
        <available file="${core.jar}" property="core.available"/>
        <fail unless="core.available" message="Compile o núcleo primeiro (cd pitiupi &amp;&amp; ant jar), ou passe -Dcore.jar=/caminho/pitiupi.jar"/>
    </target>

    <target name="compile" depends="check-core">
        <mkdir dir="${build.dir}/classes"/>
        <javac srcdir="${src.dir}" destdir="${build.dir}/classes" encoding="UTF-8"
               release="17" includeantruntime="false">
            <classpath><pathelement location="${core.jar}"/></classpath>
        </javac>
        <copy todir="${build.dir}/classes"><fileset dir="${src.dir}" includes="META-INF/**"/></copy>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/pitiupi.jogoDaVelha.jar" basedir="${build.dir}/classes"/>
        <echo>Plugin gerado: ${dist.dir}/pitiupi.jogoDaVelha.jar</echo>
    </target>

    <!-- Teste sem o núcleo original: stubs só existem em build/test-classes, nunca no JAR. -->
    <target name="test">
        <mkdir dir="${build.dir}/test-classes"/>
        <javac destdir="${build.dir}/test-classes" encoding="UTF-8" release="17"
               includeantruntime="false">
            <src path="${src.dir}"/>
            <src path="test/stubs"/>
            <src path="test/java"/>
        </javac>
        <java classname="pitiupi.jogodavelha.GameSessionTest" fork="true" failonerror="true">
            <jvmarg value="-ea"/>
            <classpath><pathelement location="${build.dir}/test-classes"/></classpath>
        </java>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>
